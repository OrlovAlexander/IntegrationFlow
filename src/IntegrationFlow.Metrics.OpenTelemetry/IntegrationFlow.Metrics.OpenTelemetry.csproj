<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>IntegrationFlow.Metrics.OpenTelemetry</RootNamespace>
    <AssemblyName>IntegrationFlow.Metrics.OpenTelemetry</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>IntegrationFlow.Metrics.OpenTelemetry</PackageId>
    <Title>IntegrationFlow Metrics (OpenTelemetry)</Title>
    <Description>OpenTelemetry-compatible metrics for IntegrationFlow via System.Diagnostics.Metrics.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IntegrationFlow.Metrics.OpenTelemetry.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IntegrationFlow.Core\IntegrationFlow.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
