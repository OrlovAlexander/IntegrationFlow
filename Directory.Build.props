<Project>
  <PropertyGroup>
    <Authors>OrlovAlexander</Authors>
    <Company>IntegrationFlow</Company>
    <Product>IntegrationFlow</Product>
    <Copyright>Copyright © IntegrationFlow</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/OrlovAlexander/IntegrationFlow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OrlovAlexander/IntegrationFlow.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>integration;rabbitmq;outbox;messaging;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
